# WSD-Pro v2 — copy this file to `.env` and fill in the required values.
# Get a key from https://ollama.com/settings/keys

# Required — used by both the chatbot and opencode (same model, qwen3:30b).
OLLAMA_API_KEY=ollama_xxx

# Optional — IDE password. If empty, a random password is generated on first
# boot and stored in the wsd-data volume (shown in the dashboard).
WSD_IDE_PASSWORD=

# Optional — model name on Ollama Cloud.
WSD_CHAT_MODEL=qwen3:30b
