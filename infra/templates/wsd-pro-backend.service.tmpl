[Unit]
Description=WSD-Pro Backend — Docker Workspace Command Center
After=docker.service network.target
Wants=docker.service

[Service]
Type=simple
User={{SERVICE_USER}}
Group={{SERVICE_USER}}
WorkingDirectory={{APP_DIR}}/backend
EnvironmentFile={{DATA_DIR}}/env.conf
ExecStart=/usr/bin/node dist/index.js
Restart=always
RestartSec=5
# Give node access to docker socket (group docker)
SupplementaryGroups=docker

# Hardening
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target