# ─────────────────────────────────────────────
# WSD-Pro — Caddy configuration (generated at install)
#
#  https://{{LAN_IP}}                → dashboard ({{DASHBOARD_PORT}})
#  http://{{LAN_IP}}                 → 308 → https
#  https://{{LAN_IP}}:{{IDE_PORT}}   → shared Web IDE (code-server)
#  {{TAILSCALE_BLOCK}}               → Tailscale IP blocks (if detected)
# ─────────────────────────────────────────────

{
    # Local CA — self-signed certs instantly, no ACME/Let's Encrypt
    # (works for LAN + Tailscale CGNAT addresses)
    local_certs
}

# Dashboard — LAN over HTTPS (browser HTTPS-First compatible)
https://{{LAN_IP}} {
    encode zstd gzip
    reverse_proxy 127.0.0.1:{{DASHBOARD_PORT}}
}

# Force HTTPS on the LAN IP
http://{{LAN_IP}} {
    redir https://{{LAN_IP}}{uri} permanent
}

# Local machine access
https://localhost {
    encode zstd gzip
    reverse_proxy 127.0.0.1:{{DASHBOARD_PORT}}
}

# Shared Web IDE (code-server, one instance for all projects)
https://{{LAN_IP}}:{{IDE_PORT}} {
    encode zstd gzip
    reverse_proxy 127.0.0.1:{{IDE_PORT}}
}
{{TAILSCALE_BLOCK}}
