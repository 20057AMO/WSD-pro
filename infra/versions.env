# ── WSD-Pro installer — pinned versions ──────────────────────
REPO_URL=https://github.com/20057AMO/WSD-pro.git
NODE_MAJOR=22
CODE_SERVER_VERSION=4.96.4
WS_WORKSPACE_IMAGE=wsd/workspace:latest

# Runtime data (NOT the app — the app lives in your clone)
DATA_DIR=/var/lib/wsd-pro
WORKSPACES_DIR=/var/lib/wsd-pro/workspaces
SERVICE_USER=wsd-pro

# Ports
DASHBOARD_PORT=3000
IDE_PORT=8100