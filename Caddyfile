# ─────────────────────────────────────────────
# WSD-Pro — Caddy configuration (LAN + HTTPS)
#
#  https://192.168.0.110  →  WSD-Pro (127.0.0.1:3000)   [self-signed TLS]
#  http://192.168.0.110   →  308 redirect to HTTPS
#  https://localhost      →  WSD-Pro (127.0.0.1:3000)   [self-signed TLS]
#  https://IP:8100        →  Web IDE (code-server, wsd-ide container)
#
# NOTE: This file is REGENERATED at install time (infra/03-caddy.sh)
# with your detected LAN / Tailscale IP. Edit it here only for dev.
# ─────────────────────────────────────────────

{
    # Local CA — issues self-signed certs instantly, no ACME/Let's Encrypt
    # (no public IP needed; works for LAN/Tailscale addresses)
    local_certs
}

# LAN access over HTTPS (browser HTTPS-First mode compatible)
https://192.168.0.110 {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3000
}

# Force HTTPS on the LAN IP
http://192.168.0.110 {
    redir https://192.168.0.110{uri} permanent
}

# Local machine access over HTTPS
https://localhost {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3000
}

# Shared Web IDE — code-server on :8100 (single instance, all projects)
https://192.168.0.110:8100 {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8100
}

# Tailscale access (fill your 100.x IP at install, or via gen-caddy.sh)
# https://100.64.0.1 {
#     encode zstd gzip
#     reverse_proxy 127.0.0.1:3000
# }
# https://100.64.0.1:8100 {
#     encode zstd gzip
#     reverse_proxy 127.0.0.1:8100
# }
