# WSD-Pro Backend — environment template
# Copy to .env and adjust. Never commit the real .env.

# HTTP server
PORT=3000
HOST=0.0.0.0

# Where project workspaces live on the host (bind-mounted into containers)
WSD_PROJECTS_DIR=/home/ahmedali/wsd-pro/workspaces

# Base image for project workspaces
# WSD_BASE_IMAGE=ubuntu:24.04
# Or the custom dev image (built by Dockerfile.workspace):
# WSD_BASE_IMAGE=wsd/workspace:latest

# ── Auth / security ──────────────────────────────────────────
# JWT signing secret — REQUIRED in production.
# If unset, a random secret is generated once and stored in data/jwt-secret.
WSD_JWT_SECRET=

# Admin account created on first boot (only if no users exist yet)
WSD_ADMIN_USER=admin
# If empty, a random password is generated and printed at first boot
WSD_ADMIN_PASSWORD=

# ── Agent bridge ─────────────────────────────────────────────
# Optional: local Ollama endpoint used by free agents
# OLLAMA_HOST=http://localhost:11434
# Optional: Ollama Cloud API key (free agents fallback)
# OLLAMA_API_KEY=

# ── Web IDE (single shared code-server on :IDE_PORT) ─────────
WSD_IDE_PORT=8100
# code-server password (generated at install if empty)
WSD_IDE_PASSWORD=

# ── Network ──────────────────────────────────────────────────
# Override the base IP used in UI links (LAN or Tailscale 100.x)
# If empty, the first non-internal IPv4 is detected automatically.
# WSD_PUBLIC_IP=192.168.0.110