# Caddyfile for remote.futrx — managed by infra/install.sh.
#
# Three site blocks:
#   1. a-ws.duckdns.org            main chat UI + backend API
#   2. code.a-ws.duckdns.org       code-server (VS Code in browser)
#   3. *.dev.a-ws.duckdns.org      per-project dev URLs (<slug>--<port>.dev.<host>)
#
# All three live behind the same Google admin session — code + dev URLs use
# forward_auth, the main block hosts the OAuth endpoints themselves.

{
    # Email used for Let's Encrypt ACME registration. Set to a real address
    # if you want renewal-failure emails from LE.
    # email you@example.com

    # On-demand TLS for the *.dev.a-ws.duckdns.org wildcard. Caddy queries the
    # backend's /internal/tls-ask before issuing each cert so attackers
    # can't burn through ACME rate limits by hitting random subdomains.
    on_demand_tls {
        ask http://127.0.0.1:7682/internal/tls-ask
    }
}

a-ws.duckdns.org {
    encode zstd gzip
    # Defense in depth: /internal/* is reachable only on loopback (Caddy →
    # backend). Reject any external attempt.
    @internal path /internal/*
    handle @internal {
        respond 403
    }
    reverse_proxy 127.0.0.1:7682
}

code.a-ws.duckdns.org {
    encode zstd gzip
    route {
        # Admin-session gate (same check as the rest of the platform).
        forward_auth 127.0.0.1:7682 {
            uri /auth/verify
        }
        # Futrx IDE launcher PWA shell (one origin => one installable app).
        handle / {
            root * /opt/remote.futrx/infra/launcher
            file_server
        }
        @launcher path /index.html /manifest.webmanifest /sw.js /icon.svg /favicon.ico
        handle @launcher {
            root * /opt/remote.futrx/infra/launcher
            file_server
        }
        # Project list for the launcher (backend, session cookie intact).
        handle /api/* {
            reverse_proxy 127.0.0.1:7682
        }
        # /<slug>/* -> that project's own per-container code-server. Same origin
        # as the launcher, so the whole thing installs as a single PWA and each
        # workspace opens in its own window. The slug prefix is stripped;
        # code-server uses relative asset paths so it works under the sub-path.
        @ide path_regexp ide ^/(?P<slug>[a-z0-9][a-z0-9-]+)(?P<rest>/.*)$
        handle @ide {
            rewrite * {re.ide.rest}
            reverse_proxy {re.ide.slug}.lxd:8842 {
                transport http {
                    keepalive off
                }
                # Strip the platform admin-session cookies before entering the
                # container (forward_auth already validated on loopback).
                header_up Cookie `(?:^|;\s*)(?:remote_session|remote_oauth_state|return_to)=[^;]*` ""
            }
        }
        # Bare /<slug> -> add trailing slash so code-server's relative URLs resolve.
        @bare path_regexp bare ^/([a-z0-9][a-z0-9-]+)$
        redir @bare {uri}/ 308
        handle {
            respond "Not found" 404
        }
    }
}

# Per-project IDE. <slug>.code.a-ws.duckdns.org proxies into the project's LXD
# container at <slug>.lxd:8842, where an on-demand, idle-stopped
# code-server lives (systemd socket activation inside the container). Same
# Google admin gate as code.a-ws.duckdns.org; on-demand TLS is gated by the
# backend's /internal/tls-ask, which now also allows <slug>.code.a-ws.duckdns.org.
*.code.a-ws.duckdns.org {
    encode zstd gzip
    tls {
        on_demand
    }
    forward_auth 127.0.0.1:7682 {
        uri /auth/verify
    }
    @valid {
        header_regexp host Host ^([a-z0-9][a-z0-9-]*)\.code\.a-ws\.duckdns\.org$
    }
    handle @valid {
        reverse_proxy {re.host.1}.lxd:8842 {
            # On-demand backend: don't pool idle upstream connections, so the
            # in-container systemd-socket-proxyd sees zero open connections soon
            # after the tab closes and can reach its --exit-idle-time to stop
            # code-server.
            transport http {
                keepalive off
            }
            # Strip the platform's admin-session cookies before the request
            # enters the container (same rationale as the dev-URL block): the
            # forward_auth above already validated the session on loopback, and
            # in-container code must never see a token replayable against
            # code.a-ws.duckdns.org.
            header_up Cookie `(?:^|;\s*)(?:remote_session|remote_oauth_state|return_to)=[^;]*` ""
        }
    }
    respond "Use <slug>.code.a-ws.duckdns.org" 400
}

# Per-project dev URLs. <slug>--<port>.dev.a-ws.duckdns.org proxies into the
# project's LXD container at <slug>.lxd:<port>. The .lxd resolution
# depends on the systemd-resolved drop-in installed by infra/steps/01-host-deps.sh.
*.dev.a-ws.duckdns.org {
    encode zstd gzip
    tls {
        on_demand
    }
    forward_auth 127.0.0.1:7682 {
        uri /auth/verify
    }
    @internal path /internal/*
    handle @internal {
        respond 403
    }
    # The Browser drawer's inspect mode serves a wrapper from the same dev
    # subdomain as the previewed app, so it can inspect iframe DOM and post
    # selected element metadata back to the main chat UI.
    handle /__remote_inspector {
        reverse_proxy 127.0.0.1:7682
    }
    @valid {
        header_regexp host Host ^([a-z0-9][a-z0-9-]*)--(\d{4,5})\.dev\.a-ws\.duckdns\.org$
    }
    handle @valid {
        reverse_proxy {re.host.1}.lxd:{re.host.2} {
            # Strip remote.futrx's own auth cookies before the request
            # enters the project container. forward_auth (above) already
            # validated the session against the main backend on loopback, so
            # the gate is unaffected; this stops any code running inside a
            # dev server from harvesting the admin session token (which would
            # otherwise be replayable against code.a-ws.duckdns.org for host root).
            # The app's own cookies pass through untouched.
            header_up Cookie `(?:^|;\s*)(?:remote_session|remote_oauth_state|return_to)=[^;]*` ""
        }
    }
    respond "Use <slug>--<port>.dev.a-ws.duckdns.org (e.g. myproj--3000.dev.a-ws.duckdns.org)" 400
}
