[Unit]
Description=Ollama — Local LLM server for WSD-Pro free agents
After=network.target

[Service]
Type=simple
User=ahmedali
Group=ahmedali
Environment=OLLAMA_MODELS=/home/ahmedali/ollama-models
Environment=OLLAMA_HOST=0.0.0.0:11434
ExecStart=/home/ahmedali/ollama-bin/bin/ollama serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
